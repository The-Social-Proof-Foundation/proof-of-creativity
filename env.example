# Database Configuration - PostgreSQL with pgvector
# Railway auto-provides DATABASE_URL when using PostgreSQL plugin
DATABASE_URL=postgresql://user:password@localhost:5432/proof_of_creativity
# Legacy support (will use DATABASE_URL if available):
DB_DSN=postgresql://user:password@localhost:5432/proof_of_creativity

# Redis Configuration (for caching and fingerprint storage)
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
# Priority: R2 (primary CDN) → GCS (optional backup) → Local (fallback)
USE_CLOUDFLARE_R2=true
USE_GCS=false
GCS_BACKUP_ENABLED=false
USE_WALRUS=false

# Cloudflare R2 (Primary for videos/CDN delivery)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=dripdrop-videos
R2_PUBLIC_DOMAIN=cdn.dripdrop.app  # Optional: custom domain for CDN URLs

# Cloudflare Stream (Video streaming platform - opt-in per upload)
# Stream provides optimized video delivery with automatic encoding and adaptive bitrate
# Usage: Set upload_to_stream=true in API request to enable for specific videos
STREAM_ACCOUNT_ID=your-cloudflare-account-id
STREAM_API_TOKEN=your-stream-api-token
STREAM_CUSTOMER_SUBDOMAIN=  # Optional: custom domain like customer-xyz.cloudflarestream.com

# Google Cloud Storage (Optional backup)
GCS_BUCKET_NAME=proof-of-creativity-testnet
# Option 1: Path to JSON key file (local development)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Option 2: Raw JSON credentials (Railway, Docker - recommended for CI/CD)
# GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Walrus (Decentralized storage - experimental)
WALRUS_ENDPOINT=https://api.walrus.xyz

# Vector Database Settings
VECTOR_DB=postgresql

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Logging
LOG_LEVEL=INFO

# Media Processing
MAX_FILE_SIZE=100000000  # 100MB in bytes
TEMP_DIR=/tmp/proof-of-creativity

# AI Model Configuration
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
EMBEDDING_DIMENSION=512

# Audio Processing
AUDIO_SAMPLE_RATE=8000
KEYFRAME_EXTRACTION_RATE=1  # frames per second

# -----------------------------------------------------------------------------
# MySocial / Proof of Creativity (oracle → chain)
# -----------------------------------------------------------------------------
# Leave MYSO_INTEGRATION_ENABLED=false for local similarity-only runs.
MYSO_INTEGRATION_ENABLED=false
MYSOCIAL_RPC_URL=https://fullnode.testnet.mysocial.io
# GraphQL indexer (localnet default: http://127.0.0.1:9125/graphql). Docker: http://host.docker.internal:9125/graphql
GRAPHQL_URL=
# On startup, refresh PoC object IDs from GraphQL (like social E2E --refresh-session)
MYSO_REFRESH_SESSION_OBJECTS=true
# Move type prefix for shared object discovery (localnet bootstrap package address)
MYSO_PLATFORM_PACKAGE_ADDRESS=0x50c1

# Published Move package + shared objects (optional when refresh enabled; used as fallback)
MYSO_POC_PACKAGE_ID=
MYSO_POC_CONFIG_ID=
MYSO_POC_REGISTRY_ID=
MYSO_POC_VAULT_DIRECTORY_ID=
MYSO_TOKEN_REGISTRY_ID=

# Wallet / mnemonic for signing txs (myso_wallet loader)
MYSO_ORACLE_PRIVATE_KEY=
# MYSO_ORACLE_MNEMONIC=
MYSO_ORACLE_CURVE=ed25519

# Default on-chain royalty redirect selector: wallet | escrow
MYSO_POC_REDIRECT_TARGET=wallet

# Operator-only: allow POST ?force_reanalyze=true to bypass active PoC preflight (dangerous; default off)
MYSO_POC_ALLOW_FORCE_RESUBMIT=false

# Short-lived in-process cache for PoCConfig (seconds)
MYSO_POC_CONFIG_CACHE_TTL_SECONDS=60

MYSO_POC_STRICT_ORACLE=false
# If true and MYSO_INTEGRATION_ENABLED=true but the client fails to init (missing IDs or oracle mismatch with strict), process exit during FastAPI lifespan startup.
MYSO_POC_FAIL_LIFESPAN_ON_MYS_MISCONFIG=false
# If true, uploads with post_id must receive a chain tx digest when MySocial client is active; otherwise HTTP 502 (sync) or failed background job.
MYSO_POC_REQUIRE_TX_WHEN_POST_ID=false

# Upload API query params (when using oracle): post object id plus optional overrides
#   POST /upload?post_id=0x…&spt_pool_id=0x…&force_reanalyze=false&creator_address=0x…&royalty_free=false
# royalty_free=true submits explicit on-chain PoC outcome 4 (royalty-free path) when integration is enabled.

# -----------------------------------------------------------------------------
# Multi-network oracle (gRPC sync + worker + WebSocket)
# -----------------------------------------------------------------------------
MYSO_NETWORK=localnet
# MYSO_NETWORKS=localnet,testnet
MAINNET_WRITES_ENABLED=false
OFF_NETWORK_FORCE_ESCROW=true
ORACLE_WORKER_CONCURRENCY=4
ORACLE_MAX_RETRIES=5
WS_PATH=/ws
WS_AUTH_REQUIRED=false
CORS_ORIGINS=http://localhost:3000

ORACLE_PRIVATE_KEY_LOCALNET=
ORACLE_PRIVATE_KEY_TESTNET=
ORACLE_PRIVATE_KEY_MAINNET=
POC_ADMIN_PRIVATE_KEY_LOCALNET=
POC_ADMIN_PRIVATE_KEY_TESTNET=
POC_ADMIN_PRIVATE_KEY_MAINNET=

# -----------------------------------------------------------------------------
# Discovery / hidden provenance (myso-discovery-service integration)
# -----------------------------------------------------------------------------
DISCOVERY_ENABLED=false
DISCOVERY_SERVICE_URL=http://127.0.0.1:8096
DISCOVERY_EMBED_SECRET=
DISCOVERY_ACTIVE_EMBEDDING_VERSION=clip-vit-b32-v1
DISCOVERY_X_HANDLE_CONFIDENCE_THRESHOLD=0.85
DISCOVERY_WORK_CONFIDENCE_THRESHOLD=0.95
DISCOVERY_COLD_START_WORK_CONFIDENCE=0.0
DISCOVERY_EXPOSE_SOURCE_IN_EVIDENCE=false

# -----------------------------------------------------------------------------
# Identity verification (myso-identity-verification claim bridge)
# -----------------------------------------------------------------------------
MYSO_IDENTITY_VERIFICATION_URL=https://identity-verification.testnet.mysocial.network
POC_IDENTITY_VERIFIER=myso-identity
ALLOW_LEGACY_OAUTH_TOKEN=false
MYSO_IDENTITY_VERIFICATION_SERVICE_SECRET=
